{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0x0funky/agent-sprite-forge/main/shared/schemas/media.schema.json",
  "title": "generate2dmedia contracts",
  "description": "Frozen contracts, version 1, for paid or quota-consuming media requests: the job record, the append-only spend ledger, the batch progress file, the readiness doctor and the price table. schemaVersion 1 jobs stay valid and resumable. Objects stay open (additionalProperties true), except a job's provider error block.",
  "$defs": {
    "job_v2": {
      "description": "job.json from generate_media.py. v2 adds the receipt, the cost estimate and the duplicate-guard fingerprint, plus the route, the API base, the consent record, the ledger reservation, the client and provider request ids, the provider's error and usage, and partialArtifact (returned bytes kept in a .partial file when they could not be published). A job is unpriced when estimate.usd is null (no verified price row). artifact is absent until the job is done, and a done job always records it; status not_sent means the request provably never left the machine.",
      "type": "object",
      "required": ["schemaVersion", "provider", "kind", "status"],
      "properties": {
        "schemaVersion": {"enum": [1, 2]},
        "provider": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "route": {"description": "How the request travels; generate_media.py writes rest.", "enum": ["rest", "codex-cli", "grok-cli", "grok-acp"]},
        "apiBase": {"type": "string", "pattern": "^https://"},
        "endpoint": {"type": "string"},
        "requestedModel": {"type": "string", "minLength": 1},
        "options": {"type": "object"},
        "promptSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "references": {"type": "array", "items": {"type": "object", "required": ["sha256"], "properties": {"sha256": {"$ref": "common.schema.json#/$defs/sha256"}}}},
        "execution": {"enum": ["dry-run", "execute"]},
        "status": {
          "enum": ["submitting", "pending", "downloading", "processing_result", "done", "failed", "expired", "pending_timeout", "submit_unknown", "interrupted", "not_sent"]
        },
        "requestId": {"type": "string", "minLength": 1},
        "clientRequestId": {"type": "string", "minLength": 1},
        "providerRequestId": {"type": "string", "minLength": 1},
        "consent": {
          "description": "What the user consented to before sending: provider, model, paid calls, the estimate (null when unpriced) and the API host.",
          "type": "object",
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "model": {"type": "string", "minLength": 1},
            "calls": {"type": "integer", "minimum": 0},
            "estimateUsd": {"type": ["number", "null"], "minimum": 0},
            "apiHost": {"type": "string", "minLength": 1}
          }
        },
        "ledger": {
          "description": "The job's reservation in <projectDir>/.forge/ledger.jsonl and its last committed status; error says why an outcome could not be committed.",
          "type": "object",
          "required": ["reservationId", "status"],
          "properties": {
            "projectDir": {"type": "string", "minLength": 1},
            "reservationId": {"type": "string", "minLength": 1},
            "status": {"enum": ["reserved", "done", "failed", "unknown", "not_sent"]},
            "error": {"type": "string"}
          }
        },
        "uploadUrl": {
          "description": "Only the host and the sha256 of a signed upload URL are stored.",
          "type": "object",
          "required": ["host", "sha256"],
          "properties": {
            "host": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
          }
        },
        "artifact": {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "common.schema.json#/$defs/relPath"},
            "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0}
          }
        },
        "partialArtifact": {
          "type": "object",
          "required": ["path", "sha256", "bytes"],
          "properties": {
            "path": {"$ref": "common.schema.json#/$defs/relPath"},
            "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
            "bytes": {"type": "integer", "minimum": 0}
          }
        },
        "returnedModel": {"type": ["string", "null"]},
        "errorType": {"type": "string", "minLength": 1},
        "error": {
          "description": "The provider's error, whitelisted and scrubbed: never a raw body, URL, prompt or credential. Closed object (additionalProperties false).",
          "type": "object",
          "properties": {
            "httpStatus": {"type": "integer"},
            "code": {"type": "string"},
            "type": {"type": "string"},
            "param": {"type": "string"},
            "message": {"type": "string", "maxLength": 300},
            "requestId": {"type": "string"}
          },
          "additionalProperties": false
        },
        "providerUsage": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "receipt": {
          "type": "object",
          "required": ["startedAt", "attempt", "toolVersion"],
          "properties": {
            "startedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
            "submittedAt": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
            "completedAt": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
            "wallMs": {"type": ["integer", "null"], "minimum": 0},
            "providerMs": {"type": ["integer", "null"], "minimum": 0},
            "attempt": {"type": "integer", "minimum": 1},
            "purpose": {"type": ["string", "null"]},
            "toolVersion": {"type": "string", "minLength": 1},
            "outcomeCode": {"type": ["string", "null"]}
          }
        },
        "estimate": {
          "description": "List-price estimate: usd is null when a needed price row is missing (basis then names it); items are the priced units (unit, quantity, usdEach, usd, source, verifiedAt and any row qualifiers).",
          "type": "object",
          "required": ["usd", "basis", "pricesVersion"],
          "properties": {
            "usd": {"type": ["number", "null"], "minimum": 0},
            "currency": {"const": "USD"},
            "basis": {"type": "string", "minLength": 1},
            "pricesVersion": {"type": "string", "minLength": 1},
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "unit": {"type": "string", "minLength": 1},
                  "quantity": {"type": "number", "minimum": 0},
                  "usdEach": {"type": "number", "minimum": 0},
                  "usd": {"type": "number", "minimum": 0}
                }
              }
            }
          }
        },
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "cliRun": {
          "type": "object",
          "required": ["tool", "runId", "cwd", "startedAt"],
          "properties": {
            "tool": {"type": "string", "minLength": 1},
            "runId": {"type": "string", "minLength": 1},
            "cwd": {"type": "string", "minLength": 1},
            "startedAt": {"$ref": "common.schema.json#/$defs/timestamp"}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"schemaVersion": {"const": 2}}, "required": ["schemaVersion"]}, "then": {"required": ["receipt", "estimate", "fingerprint"]}},
        {"if": {"properties": {"status": {"const": "done"}}, "required": ["status"]}, "then": {"required": ["artifact"]}}
      ]
    },
    "ledger_line_v1": {
      "description": "One line of <project>/.forge/ledger.jsonl. A reservation is appended before sending and later lines with the same reservationId commit it (readers fold per reservationId; the last line wins). An unknown outcome keeps the reservation counted against the caps. reservedUsd is null for an unpriced request.",
      "type": "object",
      "required": ["ts", "reservationId", "jobDir", "fingerprint", "provider", "model", "kind", "route", "reservedUsd", "status", "quotaCall"],
      "properties": {
        "schema": {"const": "generate2dmedia.ledger_line.v1"},
        "ts": {"$ref": "common.schema.json#/$defs/timestamp"},
        "jobDir": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "route": {"enum": ["rest", "codex-cli", "grok-cli", "grok-acp"]},
        "reservedUsd": {"type": ["number", "null"], "minimum": 0},
        "actualUsd": {"type": ["number", "null"], "minimum": 0},
        "status": {"enum": ["reserved", "done", "failed", "unknown", "not_sent"]},
        "quotaCall": {"type": "boolean"},
        "reservationId": {"type": "string", "minLength": 1}
      }
    },
    "batch_progress_v1": {
      "description": "<jobs stem>.progress.json written by generate_media.py batch --execute after every dispatch and result. results hold one entry per finished job (generated, reused, left-for-human or failed, with its outcomeCode); inFlight and remaining are job ids. stopped means an account-level, unknown or possibly charged outcome stopped dispatching (nothing is retried) and stopReason says which; complete means no job is left or in flight. jobsFile and jobDir are the paths the tool resolved.",
      "type": "object",
      "required": ["schema", "jobsFile", "execution", "workers", "startedAt", "updatedAt", "results", "inFlight", "remaining", "stopped", "stopReason", "complete"],
      "properties": {
        "schema": {"const": "generate2dmedia.batch_progress.v1"},
        "jobsFile": {"type": "string", "minLength": 1},
        "execution": {"enum": ["dry-run", "execute"]},
        "workers": {"type": "integer", "minimum": 1},
        "startedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "updatedAt": {"anyOf": [{"$ref": "common.schema.json#/$defs/timestamp"}, {"type": "null"}]},
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status", "outcomeCode", "jobDir"],
            "properties": {
              "id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"},
              "status": {"enum": ["generated", "reused", "left-for-human", "failed"]},
              "outcomeCode": {"type": "string", "minLength": 1},
              "jobDir": {"type": "string", "minLength": 1},
              "priorStatus": {"type": ["string", "null"]},
              "artifact": {"$ref": "common.schema.json#/$defs/relPath"},
              "estimateUsd": {"type": ["number", "null"], "minimum": 0},
              "error": {"type": "string"}
            },
            "if": {"properties": {"status": {"const": "generated"}}, "required": ["status"]},
            "then": {"required": ["artifact"]}
          }
        },
        "inFlight": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"}},
        "remaining": {"type": "array", "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$"}},
        "stopped": {"type": "boolean"},
        "stopReason": {"type": ["string", "null"]},
        "complete": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"stopped": {"const": true}}, "required": ["stopped"]}, "then": {"properties": {"stopReason": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"complete": {"const": true}}, "required": ["complete"]}, "then": {"properties": {"inFlight": {"maxItems": 0}, "remaining": {"maxItems": 0}}}}
      ]
    },
    "doctor_v1": {
      "description": "forge_doctor.py --json. Each check climbs the readiness ladder; FAIL and MISSING always carry a remedy. routes says which art routes are usable; proofs holds version-keyed verification records.",
      "type": "object",
      "required": ["schema", "checks", "routes"],
      "properties": {
        "schema": {"const": "generate2dmedia.doctor.v1"},
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "status": {"enum": ["OK", "WARN", "FAIL", "MISSING", "AGENT", "UNKNOWN"]},
              "detail": {"type": "string"},
              "remedy": {"type": "string", "minLength": 1}
            },
            "if": {"properties": {"status": {"enum": ["FAIL", "MISSING"]}}, "required": ["status"]},
            "then": {"required": ["remedy"]}
          }
        },
        "routes": {"type": "object"},
        "proofs": {"type": "object"}
      }
    },
    "prices_v1": {
      "description": "prices.json: one row per provider, model, billing unit and qualifiers (resolution, quality, size; a row that names a qualifier only matches requests with that value), each with its source and the calendar date it was verified. version becomes estimate.pricesVersion. A request with no matching row is unpriced; nothing is extrapolated.",
      "type": "object",
      "required": ["schema", "rows"],
      "properties": {
        "schema": {"const": "generate2dmedia.prices.v1"},
        "version": {"type": "string", "minLength": 1},
        "currency": {"const": "USD"},
        "notes": {"type": "string"},
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["provider", "model", "unit", "usd", "source", "verifiedAt"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "model": {"type": "string", "minLength": 1},
              "unit": {"type": "string", "minLength": 1},
              "resolution": {"type": "string", "minLength": 1},
              "quality": {"type": "string", "minLength": 1},
              "size": {"type": "string", "minLength": 1},
              "usd": {"type": "number", "minimum": 0},
              "source": {"type": "string", "minLength": 1},
              "verifiedAt": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
            }
          }
        }
      }
    }
  }
}
